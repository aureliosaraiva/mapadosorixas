  "tipo": "panorama",
  "id": "cosmologia",
  "titulo": "A cosmologia em resumo: do Ser Supremo aos ancestrais",
  "status": "rascunho",
  "atualizado": "2026-11-02",
  "secoes": [
    {
      "slug": "abertura",
