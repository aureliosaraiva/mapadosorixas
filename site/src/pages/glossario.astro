---
import Base from '../layouts/Base.astro';
import Tradicoes from '../components/Tradicoes.astro';
import Citacoes from '../components/Citacoes.astro';
import { glossario, glossarioMeta, termoPorId, ROTULO_CATEGORIA_GLOSSARIO, url } from '../lib/dados.js';

// Só entra termo com fonte (o validador já exige; aqui o build falha se não).
for (const t of glossario) {
  if (t.status !== 'com_fonte' || !t.sources?.length) throw new Error(`Termo sem fonte no glossário: ${t.id}`);
  for (const v of t.ver_tambem) if (!termoPorId[v]) throw new Error(`ver_tambem inexistente em ${t.id}: ${v}`);
}
const inicial = (t) => t.termo.normalize('NFD').replace(/\p{M}/gu, '').charAt(0).toUpperCase();
const letras = [...new Set(glossario.map(inicial))];
const categorias = Object.entries(ROTULO_CATEGORIA_GLOSSARIO)
  .map(([c, r]) => [c, r, glossario.filter((t) => t.categoria === c)])
  .filter(([, , ts]) => ts.length);
---
<Base titulo="Glossário" descricao="As palavras do Candomblé, da Umbanda e do culto aos orixás usadas no site, cada uma com a explicação e a fonte." indexar>
  <header class="cabeca-pagina">
    <p class="sobretitulo">Glossário</p>
    <h1>Palavras para entender</h1>
    <p class="chamada">{glossario.length} palavras que aparecem no site, explicadas em linguagem simples e com a obra de onde veio a explicação. Quando as obras dão sentidos diferentes, eles aparecem lado a lado.</p>
  </header>
  <p class="discreto texto-corrido">Nas páginas do site, essas palavras aparecem com sublinhado pontilhado: passe o mouse ou toque para ver a explicação. Nada do que é reservado aos iniciados é explicado aqui.</p>

  <nav aria-label="Índice do glossário">
    <p class="rotulo-busca">Por letra</p>
    <ul class="indice-letras">
      {letras.map((l) => <li><a href={`#letra-${l}`}>{l}</a></li>)}
    </ul>
    <p class="rotulo-busca">Por assunto</p>
    <ul class="sumario-pagina">
      {categorias.map(([c, r, ts]) => <li><a href={`#cat-${c}`}>{r} ({ts.length})</a></li>)}
    </ul>
  </nav>

  <h2 id="termos">De A a Z</h2>
  {letras.map((l) => (
    <section aria-labelledby={`letra-${l}`} class="glossario-letra">
      <h3 id={`letra-${l}`}>{l}</h3>
      <dl class="glossario">
        {glossario.filter((t) => inicial(t) === l).map((t) => (
          <div class="termo" id={`termo-${t.id}`} data-termo={t.id}>
            <dt>
              <span class="termo-nome">{t.termo}</span>
              {t.variantes.length > 0 && <span class="meta"> — também: {t.variantes.join(', ')}</span>}
            </dt>
            <dd>
              <p class="meta">{ROTULO_CATEGORIA_GLOSSARIO[t.categoria] ?? t.categoria}{t.tradicoes.length > 0 && <> · <Tradicoes ids={t.tradicoes} /></>}</p>
              <p class="definicao">{t.definicao}</p>
              <p class="fontes-termo"><strong>De acordo com</strong> <Citacoes sources={t.sources} /></p>
              {t.divergencias?.length > 0 && (
                <div class="divergencias-termo">
                  <p><strong>Outros sentidos registrados</strong> (lado a lado, sem que um seja o certo):</p>
                  <ul>
                    {t.divergencias.map((d) => (
                      <li class="divergencia-termo"><span class="texto">{d.texto}</span> <span class="fontes-div">(<Citacoes sources={d.sources} />)</span></li>
                    ))}
                  </ul>
                </div>
              )}
              {t.nota && <p class="nota"><strong>Observação:</strong> {t.nota}</p>}
              {t.ver_tambem.length > 0 && (
                <p class="ver-tambem"><strong>Veja também:</strong> {t.ver_tambem.map((v, i) => <>{i > 0 && ', '}<a href={`#termo-${v}`}>{termoPorId[v].termo}</a></>)}</p>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <h2 id="categorias">Por assunto</h2>
  {categorias.map(([c, r, ts]) => (
    <section aria-labelledby={`cat-${c}`}>
      <h3 id={`cat-${c}`}>{r}</h3>
      <p>{ts.map((t, i) => <>{i > 0 && ' · '}<a href={`#termo-${t.id}`}>{t.termo}</a></>)}</p>
    </section>
  ))}

  <details class="dobra" id="pendentes">
    <summary>Palavras ainda em preparo</summary>
    <div class="dobra-corpo">
      <p>Palavras que ainda não entraram, e por quê. Nenhuma delas tem explicação publicada aqui.</p>
      <ul class="pendentes-glossario">
        {glossarioMeta.pendentes.map((p) => <li><strong>{p.termo}</strong>: {p.motivo}.</li>)}
      </ul>
    </div>
  </details>
</Base>
