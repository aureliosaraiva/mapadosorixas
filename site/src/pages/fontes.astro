---
import Base from '../layouts/Base.astro';
import { fontes, usoDasFontes, ROTULO_TIPO_FONTE, ROTULO_IDIOMA } from '../lib/dados.js';
import { CAUTELA } from '../lib/capitulos.js';

// Primeiro as obras citadas no site, depois o restante da bibliografia de pesquisa;
// em cada parte, por sobrenome do primeiro autor e ano.
const porAutor = (a, b) => (a.autores[0] || '').localeCompare(b.autores[0] || '', 'pt') || (a.ano ?? 0) - (b.ano ?? 0);
const citadas = fontes.filter((f) => usoDasFontes[f.id]).sort(porAutor);
const outras = fontes.filter((f) => !usoDasFontes[f.id]).sort(porAutor);
const contar = (campo) => {
  const c = {};
  for (const f of fontes) c[f[campo]] = (c[f[campo]] || 0) + 1;
  return c;
};
const nIdioma = contar('idioma');
const nTipo = contar('tipo');
const partes = [
  { id: 'citadas', titulo: 'Obras citadas no site', intro: 'As obras de onde vêm as informações das páginas, dos capítulos e dos mitos. É para elas que apontam as notas.', lista: citadas },
  { id: 'pesquisa', titulo: 'Bibliografia de pesquisa', intro: 'Obras reunidas para leitura futura. Estar nesta lista não quer dizer que a obra já foi lida, nem que o site use alguma informação dela.', lista: outras },
];
---
<Base titulo="Fontes" descricao="As obras citadas no Mapa dos Orixás e a bibliografia de pesquisa." indexar>
  <header class="cabeca-pagina">
    <p class="sobretitulo">Fontes</p>
    <h1>De onde vêm as informações</h1>
    <p class="chamada">Livros, teses, artigos e documentos consultados. São {citadas.length} obras citadas no site e outras {outras.length} na bibliografia de pesquisa.</p>
  </header>
  <p class="discreto texto-corrido">As informações do site vêm sobretudo de pesquisas acadêmicas, de obras de sacerdotes e sacerdotisas reconhecidos e de divulgação séria, sempre com a referência conferida. Documentos de época, como os relatos de viajantes e missionários europeus, e obras de divulgação aparecem marcados como lidos com cautela.</p>

  <form class="filtros so-js" id="filtros-fontes" aria-label="Filtrar as fontes" onsubmit="return false">
    <div class="largo">
      <label for="ff-texto">Autor ou título</label>
      <input type="search" id="ff-texto" autocomplete="off" placeholder="Ex.: Verger" />
    </div>
    <div>
      <label for="ff-tipo">Tipo de obra</label>
      <select id="ff-tipo" data-campo="tipo">
        <option value="">Todos</option>
        {Object.entries(nTipo).map(([k, n]) => <option value={k}>{ROTULO_TIPO_FONTE[k] ?? k} ({n})</option>)}
      </select>
    </div>
    <div>
      <label for="ff-idioma">Idioma</label>
      <select id="ff-idioma" data-campo="idioma">
        <option value="">Todos</option>
        {Object.entries(nIdioma).map(([k, n]) => <option value={k}>{ROTULO_IDIOMA[k] ?? k} ({n})</option>)}
      </select>
    </div>
    <button type="reset">Limpar filtros</button>
  </form>
  <p class="contagem" id="ff-contagem" aria-live="polite">{fontes.length} obras</p>

  {partes.map((p) => (
    <section aria-labelledby={`parte-${p.id}`} class="parte-fontes">
      <h2 id={`parte-${p.id}`}>{p.titulo} <span class="discreto">({p.lista.length})</span></h2>
      <p class="intro-secao">{p.intro}</p>
      <ul class="lista-fontes">
        {p.lista.map((f) => (
          <li id={`fonte-${f.id}`} data-idioma={f.idioma} data-tipo={f.tipo} data-texto={`${f.autores.join(' ')} ${f.titulo}`.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()}>
            <p class="ref-fonte">
              {f.autores.join('; ')} ({f.ano ?? 's.d.'}). <cite>{f.url ? <a href={f.url} rel="noopener">{f.titulo}</a> : f.titulo}</cite>
              {f.periodico && <>. {f.periodico}</>}{f.local && <>. {f.local}</>}{f.editora && <>: {f.editora}</>}.
              {f.identificadores?.doi && <> <a href={`https://doi.org/${f.identificadores.doi}`} rel="noopener">Ver a publicação</a>.</>}
            </p>
            <p class="meta">
              <span>{ROTULO_TIPO_FONTE[f.tipo] ?? f.tipo}</span>
              <span>{ROTULO_IDIOMA[f.idioma] ?? f.idioma}</span>
              {usoDasFontes[f.id] && <span class="marca-citada">Citada no site</span>}
              {f.confiabilidade_preliminar === 'C' && <span>{CAUTELA}</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script>
    const form = document.getElementById('filtros-fontes') as HTMLFormElement;
    const itens = [...document.querySelectorAll<HTMLLIElement>('.lista-fontes > li')];
    const texto = document.getElementById('ff-texto') as HTMLInputElement;
    const selects = [...form.querySelectorAll<HTMLSelectElement>('select[data-campo]')];
    const cont = document.getElementById('ff-contagem')!;
    const norm = (t: string) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    function aplicar() {
      const q = norm(texto.value);
      let n = 0;
      for (const li of itens) {
        const d = li.dataset;
        const ok = selects.every((s) => !s.value || d[s.dataset.campo!] === s.value) && (!q || d.texto!.includes(q));
        li.hidden = !ok;
        if (ok) n++;
      }
      cont.textContent = `${n} ${n === 1 ? 'obra' : 'obras'}`;
    }
    form.addEventListener('input', aplicar);
    form.addEventListener('change', aplicar);
    form.addEventListener('reset', () => setTimeout(aplicar));
  </script>
</Base>
