---
import Base from '../../layouts/Base.astro';
import Tradicoes from '../../components/Tradicoes.astro';
import { itans, hrefEntidade, rotuloEntidade, tradicoes, url } from '../../lib/dados.js';

const ordemTrad = (a, b) => tradicoes.findIndex((t) => t.id === a) - tradicoes.findIndex((t) => t.id === b);
const tradsDo = (it) => [...new Set(it.versoes.flatMap((v) => v.tradicoes))].sort(ordemTrad);
---
<Base titulo="Mitos" descricao="Itãs, as narrativas sobre os orixás, com as versões de cada fonte lado a lado e resumos com palavras próprias.">
  <header class="cabeca-pagina">
    <p class="sobretitulo">Mitos</p>
    <h1>Itãs: as histórias dos orixás</h1>
    <p class="chamada">Itãs são as narrativas que contam a vida, os feitos e as relações dos orixás. Aqui, cada história reúne lado a lado as versões registradas por diferentes obras, sem que uma seja tomada como a certa.</p>
  </header>
  <p class="discreto texto-corrido">Os títulos foram dados pelo projeto para descrever cada história. Os resumos são escritos com palavras próprias, nunca copiados dos livros, e cada versão indica a obra e a página. São {itans.length} histórias, e a lista cresce à medida que novas obras são lidas.</p>

  <ul class="grade lista-itans">
    {itans.map((it) => (
      <li class="cartao" id={it.id} data-ita={it.id}>
        <h2><a class="cartao-link" href={url(`itans/${it.id}`)}>{it.titulo}</a></h2>
        <p class="resumo-cartao">Com {it.entidades.map((e, i) => {
          const h = hrefEntidade(e);
          return <>{i > 0 && (i === it.entidades.length - 1 ? ' e ' : ', ')}{h ? <a href={h}>{rotuloEntidade(e)}</a> : rotuloEntidade(e)}</>;
        })}</p>
        <p><Tradicoes ids={tradsDo(it)} /></p>
        <p class="rodape-cartao"><span>{it.versoes.length} {it.versoes.length === 1 ? 'versão' : 'versões'}</span></p>
      </li>
    ))}
  </ul>
</Base>
