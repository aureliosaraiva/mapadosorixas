---
import Base from '../../layouts/Base.astro';
import Selo from '../../components/Selo.astro';
import Icone from '../../components/Icone.astro';
import Tradicoes from '../../components/Tradicoes.astro';
import Citacoes from '../../components/Citacoes.astro';
import { itans, itaPorId, hrefEntidade, rotuloEntidade, conexoes, ROTULO_ARESTA, ROTULO_SUBTIPO, rotuloNo, fichaPorId, url } from '../../lib/dados.js';

export function getStaticPaths() {
  return itans.map((it) => ({ params: { id: it.id } }));
}
const { id } = Astro.params;
const it = itaPorId[id];
const arestas = conexoes.arestas.filter((a) => it.arestas.includes(a.id));
const ancora = (aid) => `aresta-${aid.replace(/[^a-z0-9-]/gi, '-')}`;
const idVersao = (v, i) => (v.registro ? `vi-${v.registro}` : `vi-${id}-${i + 1}`);
---
<Base titulo={it.titulo} descricao={`Mito: ${it.titulo}. As versões de cada obra lado a lado, com tradição e fonte.`} indexar>
  <p class="trilha"><a href={url('itans')}><Icone nome="voltar" tamanho={16} />Mitos</a></p>
  <header class="cabeca-pagina">
    <p class="sobretitulo">Mito</p>
    <h1>{it.titulo}</h1>
    <p class="chamada">Com {it.entidades.map((e, i) => {
      const h = hrefEntidade(e);
      return <>{i > 0 && (i === it.entidades.length - 1 ? ' e ' : ', ')}{h ? <a href={h}>{rotuloEntidade(e)}</a> : rotuloEntidade(e)}</>;
    })}. {it.versoes.length === 1 ? 'Uma versão registrada.' : `${it.versoes.length} versões, lado a lado, sem que uma seja tomada como a certa.`}</p>
  </header>
  <Selo />
  <p class="discreto texto-corrido">Cada resumo foi escrito pelo projeto com palavras próprias e indica a obra e a página de onde veio.</p>
  {it.nota_curadoria && <p class="nota-caixa nota-curadoria"><strong>Nota sobre esta história:</strong> {it.nota_curadoria}</p>}

  <section aria-labelledby="versoes">
    <h2 id="versoes">{it.versoes.length === 1 ? 'A versão' : 'As versões'}</h2>
    <ol class="versoes versoes-ita">
      {it.versoes.map((v, i) => {
        const dono = v.registro ? v.registro.replace(/-\d+$/, '') : null;
        return (
          <li class="versao versao-ita" id={idVersao(v, i)} data-registro={v.registro ?? ''}>
            <span class="valor">{v.valor}</span>
            <div class="meta">
              <Tradicoes ids={v.tradicoes} />
              {v.casa_ou_regiao && <span> · {v.casa_ou_regiao}</span>}
            </div>
            <p class="resumo">{v.resumo}</p>
            {v.odu && <p class="odu"><strong><a href={url('glossario#termo-odu')}>Odu</a> ligado a esta história pela obra:</strong> {v.odu.nome} ({v.odu.loc})</p>}
            {v.nota && <p class="nota"><strong>Observação:</strong> {v.nota}</p>}
            <p class="fontes-ita"><strong>De acordo com</strong> <Citacoes sources={v.sources} /></p>
            {v.registro && fichaPorId[dono] && <p class="meta">Também na página de <a href={url(`orixas/${dono}#v-${v.registro}`)}>{fichaPorId[dono].rotulo}</a>.</p>}
          </li>
        );
      })}
    </ol>
  </section>

  <section aria-labelledby="conexoes-ita">
    <h2 id="conexoes-ita">Relações que esta história mostra</h2>
    {arestas.length === 0
      ? <p>Nenhuma relação do mapa de conexões vem destas versões. Um parentesco só entra no mapa quando a obra o afirma com clareza.</p>
      : (
        <ul>
          {arestas.map((e) => (
            <li><a href={url(`grafo#${ancora(e.id)}`)}>{ROTULO_ARESTA[e.tipo] ?? e.tipo}: {rotuloNo(e.origem)} {e.subtipo ? ROTULO_SUBTIPO[e.subtipo] ?? e.subtipo : '—'} {rotuloNo(e.destino)}</a></li>
          ))}
        </ul>
      )}
  </section>
</Base>
