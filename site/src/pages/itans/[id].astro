---
import Base from '../../layouts/Base.astro';
import Selo from '../../components/Selo.astro';
import Tradicoes from '../../components/Tradicoes.astro';
import Citacoes from '../../components/Citacoes.astro';
import { itans, itaPorId, hrefEntidade, rotuloEntidade, conexoes, ROTULO_ARESTA, ROTULO_SUBTIPO, rotuloNo, fichaPorId, url } from '../../lib/dados.js';

export function getStaticPaths() {
  return itans.map((it) => ({ params: { id: it.id } }));
}
const { id } = Astro.params;
const it = itaPorId[id];
const arestas = conexoes.arestas.filter((a) => it.arestas.includes(a.id));
const ancora = (aid) => `aresta-${aid.replace(/[^a-z0-9-]/gi, '-')}`;
const idVersao = (v, i) => (v.registro ? `vi-${v.registro}` : `vi-${id}-${i + 1}`);
---
<Base titulo={it.titulo} descricao={`Itã: ${it.titulo}. Versões lado a lado, com tradição e fonte.`} indexar>
  <p><a href={url('itans')}>← Itãs</a></p>
  <h1>{it.titulo}</h1>
  <Selo />
  <p><strong>Entidades:</strong> {it.entidades.map((e, i) => {
    const h = hrefEntidade(e);
    return <>{i > 0 && ', '}{h ? <a href={h}>{rotuloEntidade(e)}</a> : rotuloEntidade(e)}</>;
  })}</p>
  <p>{it.versoes.length} {it.versoes.length === 1 ? 'versão registrada' : 'versões registradas, lado a lado e sem hierarquia'}. Cada resumo é uma paráfrase do projeto, com a fonte e a página.</p>
  {it.nota_curadoria && <p class="nota-caixa nota-curadoria"><strong>Curadoria:</strong> {it.nota_curadoria}</p>}

  <section aria-labelledby="versoes">
    <h2 id="versoes">Versões</h2>
    <ol class="versoes versoes-ita">
      {it.versoes.map((v, i) => {
        const dono = v.registro ? v.registro.replace(/-\d+$/, '') : null;
        return (
          <li class="versao versao-ita" id={idVersao(v, i)} data-registro={v.registro ?? ''}>
            <span class="valor">{v.valor}</span>
            <div class="meta">
              <Tradicoes ids={v.tradicoes} />
              {v.casa_ou_regiao && <span> · Casa ou região: {v.casa_ou_regiao}</span>}
            </div>
            <p class="resumo">{v.resumo}</p>
            {v.odu && <p class="odu"><strong>Odu associado pela fonte:</strong> {v.odu.nome} ({v.odu.loc})</p>}
            {v.nota && <p class="nota"><strong>Nota do fichamento:</strong> {v.nota}</p>}
            <p class="fontes-ita"><strong>Fonte:</strong> <Citacoes sources={v.sources} /></p>
            {v.registro && fichaPorId[dono] && <p class="meta">Registro <code>{v.registro}</code>, também na ficha de <a href={url(`orixas/${dono}#v-${v.registro}`)}>{fichaPorId[dono].rotulo}</a>.</p>}
          </li>
        );
      })}
    </ol>
  </section>

  <section aria-labelledby="conexoes-ita">
    <h2 id="conexoes-ita">Conexões no grafo</h2>
    {arestas.length === 0
      ? <p>Nenhuma conexão do grafo é sustentada por estas versões. Parentescos e outras relações só viram conexão quando o registro de fichamento os afirma.</p>
      : (
        <ul>
          {arestas.map((e) => (
            <li><a href={url(`grafo#${ancora(e.id)}`)}>{ROTULO_ARESTA[e.tipo] ?? e.tipo}: {rotuloNo(e.origem)} {e.subtipo ? ROTULO_SUBTIPO[e.subtipo] ?? e.subtipo : '—'} {rotuloNo(e.destino)}</a></li>
          ))}
        </ul>
      )}
  </section>
</Base>
