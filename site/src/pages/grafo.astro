---
import Base from '../layouts/Base.astro';
import Tradicoes from '../components/Tradicoes.astro';
import cytoscapeBuild from 'cytoscape';
import {
  conexoes, entidades, fichaPorId, fontePorId, autorCurto, tradicoes, ROTULO_GRUPO,
  ROTULO_ARESTA, ROTULO_SUBTIPO, ROTULO_NO, rotuloNo, url,
} from '../lib/dados.js';
import { CORES_ARESTA, FORMA_NO, ROTULO_LINHA, tradDaAresta, elementosCytoscape, tipoEntidadeNo, rotuloTipoEntidade } from '../lib/grafo.js';

const tiposAresta = Object.keys(conexoes._meta.por_tipo);
const tiposNo = [...new Set(conexoes.nos.map((n) => n.tipo))];
const contaEnt = {};
for (const n of conexoes.nos) contaEnt[tipoEntidadeNo(n)] = (contaEnt[tipoEntidadeNo(n)] || 0) + 1;
const tiposEnt = Object.keys(contaEnt);
const tradsUsadas = new Set(conexoes.arestas.flatMap(tradDaAresta));
const grupos = Object.entries(ROTULO_GRUPO)
  .map(([g, rot]) => [rot, tradicoes.filter((t) => t.grupo === g && tradsUsadas.has(t.id))])
  .filter(([, ts]) => ts.length);

// Posições calculadas no build (Cytoscape sem tela, layout 'cose'): o navegador só
// desenha (layout 'preset'), sem o cálculo pesado que travava a página.
const elementos = elementosCytoscape(conexoes.nos, conexoes.arestas);
{
  const cyBuild = cytoscapeBuild({ headless: true, elements: elementos, styleEnabled: true, style: [{ selector: 'node', style: { width: 22, height: 22 } }, { selector: 'node[tipo = "orixa"]', style: { width: 40, height: 40 } }] });
  cyBuild.layout({ name: 'cose', animate: false, randomize: true, nodeRepulsion: () => 9000, idealEdgeLength: () => 90, padding: 20 } as any).run();
  const pos = Object.fromEntries(cyBuild.nodes().map((n) => [n.id(), n.position()]));
  for (const el of elementos) if (!('source' in el.data)) (el as any).position = { x: Math.round(pos[el.data.id].x), y: Math.round(pos[el.data.id].y) };
}

const fonteCurta = (v) => {
  const f = fontePorId[v.source_id];
  const via = v.via_source_id ? fontePorId[v.via_source_id] : null;
  return { f, via, loc: v.localizacao };
};
---
<Base titulo="Mapa de conexões" descricao="Mapa das relações entre orixás nos mitos e nas tradições: parentesco, nomes equivalentes e sincretismo, com fontes.">
  <header class="cabeca-pagina">
    <p class="sobretitulo">Mapa de conexões</p>
    <h1>Quem se liga a quem</h1>
    <p class="chamada">Um desenho das relações que as obras registram: parentes nos mitos, companheiros de culto, nomes equivalentes em outras tradições (voduns, inquices) e santos católicos associados pelo sincretismo.</p>
  </header>
  <ol class="passos">
    <li>Cada ponto é um nome; cada linha, uma relação registrada numa obra. Forma e tipo de linha mudam conforme o tipo (veja a legenda).</li>
    <li>Toque num orixá com borda dourada para abrir a página dele. Use os filtros para ver só um tipo de relação ou uma tradição.</li>
    <li>Prefere ler? A <a href="#tabela-conexoes">lista de conexões</a>, mais abaixo, traz tudo em texto, com as fontes.</li>
  </ol>
  <p class="nota-caixa"><strong>Equivalente não quer dizer igual.</strong> Cada divindade tem culto, mitos e características próprios na sua tradição, e o sincretismo com santos católicos muda de casa para casa e de região para região.</p>

  <form class="filtros so-js" id="filtros-grafo" aria-label="Filtrar o mapa" onsubmit="return false">
    <fieldset class="largo">
      <legend>Tipos de relação</legend>
      {tiposAresta.map((t) => (
        <label class="opcao"><input type="checkbox" name="tipo" value={t} checked /> {ROTULO_ARESTA[t] ?? t} ({conexoes._meta.por_tipo[t]})</label>
      ))}
    </fieldset>
    <fieldset class="largo">
      <legend>Tipos de nome</legend>
      {tiposEnt.map((t) => (
        <label class="opcao"><input type="checkbox" name="tipo-entidade" value={t} checked /> {rotuloTipoEntidade(t)} ({contaEnt[t]})</label>
      ))}
    </fieldset>
    <div>
      <label for="g-tradicao">Tradição</label>
      <select id="g-tradicao">
        <option value="">Todas</option>
        {grupos.map(([rot, ts]) => (
          <optgroup label={rot}>{ts.map((t) => <option value={t.id}>{t.nome}</option>)}</optgroup>
        ))}
      </select>
    </div>
    <div>
      <label for="g-ir">Ir para a página de</label>
      <select id="g-ir">
        <option value="">Escolha um nome…</option>
        {conexoes.nos.filter((n) => fichaPorId[n.id]).map((n) => <option value={url(`orixas/${n.id}`)}>{n.rotulo}</option>)}
      </select>
    </div>
    <button type="reset">Limpar filtros</button>
  </form>

  <div class="grafo-caixa so-js">
    <div id="grafo" role="img" aria-label="Mapa das conexões entre orixás, santos, voduns, inquices e outras entidades. A lista mais abaixo descreve as mesmas conexões."></div>
  </div>
  <p class="contagem so-js" id="g-contagem" aria-live="polite"></p>
  <noscript><p class="nota-caixa">O desenho precisa de JavaScript ligado no navegador. Todas as conexões estão na lista abaixo.</p></noscript>

  <h2>Legenda</h2>
  <h3>Formas dos nomes</h3>
  <ul class="legenda">
    {tiposNo.map((t) => (
      <li><span class="amostra" style={`background:${FORMA_NO[t]?.cor}`}></span>{ROTULO_NO[t] ?? t} — {FORMA_NO[t]?.rotulo}</li>
    ))}
  </ul>
  <h3>Linhas das relações</h3>
  <ul class="legenda">
    {tiposAresta.map((t) => (
      <li><span class="linha" style={`border-top-style:${CORES_ARESTA[t].estilo};border-top-color:${CORES_ARESTA[t].cor}`}></span>{ROTULO_ARESTA[t]} — linha {ROTULO_LINHA[CORES_ARESTA[t].estilo]}</li>
    ))}
  </ul>

  <h2 id="tabela-conexoes">As conexões em lista</h2>
  <p class="intro-secao">{conexoes.arestas.length} relações, agrupadas por tipo, cada uma com a obra e a página de onde veio.</p>
  <div class="tabela-rolagem">
    <table>
      <caption class="visualmente-oculto">{conexoes.arestas.length} conexões, agrupadas por tipo</caption>
      <thead><tr><th scope="col">Tipo</th><th scope="col">De</th><th scope="col">Relação</th><th scope="col">Para</th><th scope="col">De acordo com</th></tr></thead>
      <tbody>
        {tiposAresta.flatMap((t) => conexoes.arestas.filter((e) => e.tipo === t)).map((e) => (
          <tr id={`aresta-${e.id.replace(/[^a-z0-9-]/gi, '-')}`}>
            <td>{ROTULO_ARESTA[e.tipo] ?? e.tipo}</td>
            <td>{fichaPorId[e.origem] ? <a href={url(`orixas/${e.origem}`)}>{rotuloNo(e.origem)}</a> : rotuloNo(e.origem)}</td>
            <td>{e.subtipo ? ROTULO_SUBTIPO[e.subtipo] ?? e.subtipo : (e.direcionada ? '→' : '—')}</td>
            <td>{fichaPorId[e.destino] ? <a href={url(`orixas/${e.destino}`)}>{rotuloNo(e.destino)}</a> : rotuloNo(e.destino)}</td>
            <td>
              <ul style="margin:0;padding-left:1rem">
                {e.versoes.map((v) => {
                  const { f, via, loc } = fonteCurta(v);
                  return (
                    <li>
                      “{v.valor}” <Tradicoes ids={v.tradicoes} />{v.casa_ou_regiao && <> ({v.casa_ou_regiao})</>} —{' '}
                      <a href={url(`fontes#fonte-${v.source_id}`)}>{autorCurto(f)} ({f?.ano})</a>
                      {via && <>, citado por <a href={url(`fontes#fonte-${v.via_source_id}`)}>{autorCurto(via)} ({via.ano})</a></>}, {loc}
                    </li>
                  );
                })}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="entidades">Nomes equivalentes em outras tradições</h2>
  <p class="intro-secao">Voduns (tradição jeje), inquices (tradição banto) e outros nomes que as obras aproximam de um orixá. A aproximação é da obra citada, não uma identidade. Alguns aparecem como “fon ou banto (sem classificação)” porque a obra não diz de qual das duas tradições o nome vem.</p>
  <div class="tabela-rolagem">
    <table>
      <caption class="visualmente-oculto">{entidades.length} nomes equivalentes</caption>
      <thead><tr><th scope="col">Nome</th><th scope="col">Tipo</th><th scope="col">Tradições</th><th scope="col">Aproximado de</th><th scope="col">De acordo com</th></tr></thead>
      <tbody>
        {entidades.map((en) => (
          <tr>
            <td>{en.rotulo}</td>
            <td>{ROTULO_NO[en.tipo] ?? en.tipo}</td>
            <td><Tradicoes ids={en.tradicoes} /></td>
            <td>{en.equivale_a.map((q, i) => <>{i > 0 && ', '}<a href={url(`orixas/${q.orixa}`)}>{rotuloNo(q.orixa)}</a></>)}</td>
            <td>{en.versoes.map((v, i) => {
              const { f, via, loc } = fonteCurta(v);
              return <>{i > 0 && '; '}<a href={url(`fontes#fonte-${v.source_id}`)}>{autorCurto(f)} ({f?.ano})</a>{via && <>, citado por {autorCurto(via)} ({via.ano})</>}, {loc}</>;
            })}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script type="application/json" id="dados-grafo" set:html={JSON.stringify(elementos)}></script>
  <script>
    import cytoscape from 'cytoscape';
    import { estiloCytoscape } from '../lib/estilo-cytoscape';

    const elementos = JSON.parse(document.getElementById('dados-grafo')!.textContent!);
    const cy = cytoscape({
      container: document.getElementById('grafo'),
      elements: elementos,
      minZoom: 0.3,
      maxZoom: 3,
      wheelSensitivity: 0.3,
      style: estiloCytoscape(),
      layout: { name: 'preset', padding: 20 } as any,
    });

    cy.on('tap', 'node', (ev) => {
      const href = ev.target.data('href');
      if (href) window.location.href = href;
    });
    cy.on('mouseover', 'node[href != ""]', () => { (cy.container() as HTMLElement).style.cursor = 'pointer'; });
    cy.on('mouseout', 'node', () => { (cy.container() as HTMLElement).style.cursor = ''; });

    const form = document.getElementById('filtros-grafo') as HTMLFormElement;
    const selTrad = document.getElementById('g-tradicao') as HTMLSelectElement;
    const selIr = document.getElementById('g-ir') as HTMLSelectElement;
    const cont = document.getElementById('g-contagem')!;

    function aplicar() {
      const tipos = new Set([...form.querySelectorAll<HTMLInputElement>('input[name=tipo]:checked')].map((i) => i.value));
      const trad = selTrad.value;
      const ents = new Set([...form.querySelectorAll<HTMLInputElement>('input[name=tipo-entidade]:checked')].map((i) => i.value));
      cy.batch(() => {
        cy.edges().forEach((e) => {
          const ok = tipos.has(e.data('tipo')) && (!trad || e.data('tradicoes').includes(trad))
            && ents.has(e.source().data('tipoEnt')) && ents.has(e.target().data('tipoEnt'));
          e.toggleClass('oculto', !ok);
        });
        cy.nodes().forEach((n) => {
          const visivel = n.connectedEdges().some((e) => !e.hasClass('oculto'));
          n.toggleClass('oculto', !ents.has(n.data('tipoEnt')) || (!visivel && !(n.data('href') && !trad && tipos.size > 0)));
        });
      });
      const ne = cy.edges().filter((e) => !e.hasClass('oculto')).length;
      const nn = cy.nodes().filter((n) => !n.hasClass('oculto')).length;
      cont.textContent = `Mostrando ${nn} nomes e ${ne} relações.`;
    }
    form.addEventListener('change', (ev) => { if (ev.target !== selIr) aplicar(); });
    form.addEventListener('reset', () => setTimeout(aplicar));
    selIr.addEventListener('change', () => { if (selIr.value) window.location.href = selIr.value; });
    aplicar();
    window.addEventListener('tema-mudou', () => cy.style(estiloCytoscape() as any));
  </script>
</Base>
