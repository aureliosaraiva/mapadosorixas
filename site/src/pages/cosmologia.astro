---
import Base from '../layouts/Base.astro';
import Tradicoes from '../components/Tradicoes.astro';
import Citacoes from '../components/Citacoes.astro';
import Icone from '../components/Icone.astro';
import { fichas, listaEntidades, fichaPorId, ROTULO_TIPO_ENTIDADE, hrefEntidade, url } from '../lib/dados.js';
import { panoramaPorId } from '../lib/capitulos.js';

const panorama = panoramaPorId.cosmologia;

// Só o que tem fonte: versões do atributo 'hierarquia' das fichas geradas.
const comHierarquia = fichas.filter((f) => f.atributos.hierarquia?.length);
const nVersoes = comHierarquia.reduce((n, f) => n + f.atributos.hierarquia.length, 0);
// Entidades da lista-mestra cujo tipo é cosmológico: listadas só pelo nome.
const TIPOS_COSMO = ['divindade_suprema', 'conceito_cosmologico', 'ancestral'];
const cosmo = TIPOS_COSMO.map((t) => [t, listaEntidades.filter((e) => e.tipo === t)]).filter(([, es]) => es.length);
---
<Base titulo="Cosmologia" descricao="Como as tradições descrevem o mundo: Orum e Aiê, a divindade suprema, o Orí e os ancestrais, com fontes e versões lado a lado.">
  <header class="cabeca-pagina">
    <p class="sobretitulo">Cosmologia</p>
    <h1>O mundo, os deuses e os ancestrais</h1>
    <p class="chamada">O que as obras dizem sobre o lugar de cada divindade e de cada conceito no mundo: a relação com a divindade suprema, com o Orum e o Aiê, entre os orixás e com os ancestrais.</p>
  </header>
  <p class="discreto texto-corrido">Não existe um panteão único, igual em todas as tradições, nem mesmo em terra iorubá. Por isso cada afirmação aparece como uma versão, com a tradição e a fonte, ao lado das outras.</p>
  {panorama && <p class="destaque-capitulo link-capitulo" id="link-panorama"><span class="sobretitulo">Para ler em texto corrido</span><a class="botao" href={url('cosmologia/capitulo')}><Icone nome="livro" tamanho={18} />{panorama.titulo}</a><span>Uma visão de conjunto que liga os capítulos de Olodumare, Orum, Aiê, Orí, Odudua, Olokun e Egungun.</span></p>}

  <section aria-labelledby="versoes-hierarquia">
    <h2 id="versoes-hierarquia">O que cada obra diz</h2>
    {nVersoes === 0 ? (
      <p class="nota-caixa aviso-vazio" id="aviso-sem-hierarquia"><strong>Ainda não há informações com fonte sobre este tema.</strong> Esta parte será preenchida à medida que as obras forem lidas. Nada aqui é escrito sem fonte.</p>
    ) : (
      <>
        <p>{nVersoes} informações sobre {comHierarquia.length} divindades e conceitos.</p>
        {comHierarquia.map((f) => (
          <section class="hierarquia-entidade" aria-labelledby={`h-${f.id}`}>
            <h3 id={`h-${f.id}`}><a href={url(`orixas/${f.id}#hierarquia`)}>{f.rotulo}</a></h3>
            <ul class="versoes duas-colunas">
              {f.atributos.hierarquia.map((v) => (
                <li class="versao versao-hierarquia" id={`hv-${v.registro}`} data-registro={v.registro}>
                  <span class="valor">{v.valor}</span>
                  <div class="meta"><Tradicoes ids={v.tradicoes} />{v.casa_ou_regiao && <span> · {v.casa_ou_regiao}</span>}</div>
                  <p class="resumo">{v.parafrase}</p>
                  <p class="fontes-hierarquia"><strong>De acordo com</strong> <Citacoes sources={v.sources} /></p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )}
  </section>

  <section aria-labelledby="em-pesquisa">
    <h2 id="em-pesquisa">Divindades e conceitos deste tema</h2>
    <p>A divindade suprema, os conceitos sobre o mundo e a pessoa, e os ancestrais que o projeto cobre ou pretende cobrir. O agrupamento só organiza a lista; não é uma afirmação das tradições. Os que estão em estudo aparecem só pelo nome.</p>
    {cosmo.map(([t, es]) => (
      <>
        <h3>{ROTULO_TIPO_ENTIDADE[t]}</h3>
        <ul class="lista-cosmo">
          {es.map((e) => (
            <li data-entidade={e.id}>
              <a href={hrefEntidade(e.id)}>{e.rotulo}</a> — {fichaPorId[e.id] ? 'com página' : 'em estudo'}
              {e.sensivel && <span class="aviso-sensivel"> (tema sensível: só o que já é público em livros e pesquisas)</span>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>
</Base>
