---
import Base from '../layouts/Base.astro';
import Tradicoes from '../components/Tradicoes.astro';
import Icone from '../components/Icone.astro';
import {
  fichaPorId, listaEntidades, tradicoes, ROTULO_GRUPO, tradicoesDaFicha,
  fontesDaFicha, url, ROTULO_TIPO_ENTIDADE, ROTULO_GRUPO_ENTIDADE, grupoConfirmado, itans,
} from '../lib/dados.js';
import { capituloPorId } from '../lib/capitulos.js';

// Um cartão por entidade da lista-mestra (data/entidades.json): primeiro as que têm
// página, na ordem da lista; depois as que estão em estudo (só nome e tipo, nenhum texto).
const MAX_TRADS = 4;
const cartoes = listaEntidades.map((e) => {
  const f = fichaPorId[e.id];
  if (!f) return { e, f: null, trads: [] };
  return {
    e, f,
    trads: tradicoesDaFicha(f),
    nFontes: fontesDaFicha(f).size,
    nItans: itans.filter((it) => it.entidades.includes(e.id)).length,
    cap: !!capituloPorId[e.id],
  };
}).sort((a, b) => Number(!a.f) - Number(!b.f));
const nComPagina = cartoes.filter((c) => c.f).length;
const nPesquisa = cartoes.length - nComPagina;
const tiposUsados = Object.keys(ROTULO_TIPO_ENTIDADE).filter((t) => cartoes.some((c) => c.e.tipo === t));
const tradsUsadas = new Set(cartoes.flatMap((c) => c.trads));
const grupos = Object.entries(ROTULO_GRUPO)
  .map(([g, rot]) => [rot, tradicoes.filter((t) => t.grupo === g && tradsUsadas.has(t.id))])
  .filter(([, ts]) => ts.length);
const semAcento = (t) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
---
<Base titulo="Orixás" descricao="Os orixás e as demais entidades do Mapa dos Orixás, com filtros por tipo e por tradição.">
  <header class="cabeca-pagina">
    <p class="sobretitulo">Catálogo</p>
    <h1>Orixás e entidades</h1>
    <p class="chamada">{nComPagina} orixás, entidades e conceitos já têm página, com resumo, fontes e as diferenças entre tradições. Outros {nPesquisa} estão em estudo e aparecem só pelo nome até haver obra lida sobre eles.</p>
  </header>
  <p class="discreto">O tipo de cada entidade (orixá, qualidade, divindade suprema, conceito, ancestrais) serve só para organizar esta lista; não é uma afirmação das tradições. As cores das etiquetas indicam o grupo de tradições: veja <a href={url('tradicoes')}>tradições e nações</a>.</p>

  <form class="filtros so-js" id="filtros-catalogo" aria-label="Filtrar a lista" onsubmit="return false">
    <div>
      <label for="f-nome">Nome</label>
      <input type="search" id="f-nome" autocomplete="off" placeholder="Ex.: Oxum" />
    </div>
    <div>
      <label for="f-tipo">Tipo</label>
      <select id="f-tipo">
        <option value="">Todos</option>
        {tiposUsados.map((t) => <option value={t}>{ROTULO_TIPO_ENTIDADE[t]}</option>)}
      </select>
    </div>
    <div>
      <label for="f-tradicao">Tradição</label>
      <select id="f-tradicao">
        <option value="">Todas</option>
        {grupos.map(([rot, ts]) => (
          <optgroup label={rot}>
            {ts.map((t) => <option value={t.id}>{t.nome}</option>)}
          </optgroup>
        ))}
      </select>
    </div>
    <div>
      <label for="f-situacao">Mostrar</label>
      <select id="f-situacao">
        <option value="">Todos</option>
        <option value="ficha">Só os que têm página</option>
        <option value="capitulo">Só os que têm capítulo</option>
        <option value="pesquisa">Só os que estão em estudo</option>
      </select>
    </div>
    <button type="reset">Limpar filtros</button>
  </form>
  <p class="contagem" id="contagem" aria-live="polite">{cartoes.length} nomes</p>

  <ul class="grade" id="cartoes">
    {cartoes.map((c) => {
      const g = grupoConfirmado(c.e);
      return c.f ? (
        <li class="cartao" id={`e-${c.e.id}`} data-entidade={c.e.id} data-situacao="ficha" data-capitulo={c.cap ? '1' : ''} data-tipo={c.e.tipo} data-tradicoes={c.trads.join(' ')} data-nome={semAcento(c.f.rotulo)}>
          <p class="tipo-entidade">{ROTULO_TIPO_ENTIDADE[c.e.tipo]}{g && <> · {ROTULO_GRUPO_ENTIDADE[g.rotulo]}</>}</p>
          <h2><a class="cartao-link" href={url(`orixas/${c.e.id}`)}>{c.f.rotulo}</a></h2>
          <p class="resumo-cartao"><Tradicoes ids={c.trads.slice(0, MAX_TRADS)} link />{c.trads.length > MAX_TRADS && <span class="discreto"> e mais {c.trads.length - MAX_TRADS}</span>}</p>
          {c.e.sensivel && <p class="aviso-sensivel">Tema sensível: só o que já é público em livros e pesquisas.</p>}
          <p class="rodape-cartao">
            {c.cap && <span class="selo-cap"><Icone nome="livro" tamanho={14} />Capítulo para ler</span>}
            {c.nItans > 0 && <span>{c.nItans} {c.nItans === 1 ? 'mito' : 'mitos'}</span>}
            <span>{c.nFontes} {c.nFontes === 1 ? 'obra consultada' : 'obras consultadas'}</span>
          </p>
        </li>
      ) : (
        <li class="cartao em-pesquisa" id={`e-${c.e.id}`} data-entidade={c.e.id} data-situacao="pesquisa" data-capitulo="" data-tipo={c.e.tipo} data-tradicoes="" data-nome={semAcento(c.e.rotulo)}>
          <p class="tipo-entidade">{ROTULO_TIPO_ENTIDADE[c.e.tipo]}</p>
          <h2>{c.e.rotulo}</h2>
          <p class="status-pesquisa"><strong>Em pesquisa</strong> — {c.e.status_conteudo === 'pre' ? 'há indicações em outras obras, mas a fonte original ainda não foi lida' : 'ainda sem obra lida'}. Nada é publicado antes disso.</p>
          {c.e.sensivel && <p class="aviso-sensivel">Tema sensível: só entrará o que já for público em livros e pesquisas.</p>}
        </li>
      );
    })}
  </ul>
  <p id="nenhum" hidden>Nenhum nome para essa combinação de filtros.</p>

  <script>
    const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const nome = document.getElementById('f-nome') as HTMLInputElement;
    const tp = sel('f-tipo');
    const si = sel('f-situacao');
    const tr = sel('f-tradicao');
    const form = document.getElementById('filtros-catalogo') as HTMLFormElement;
    const cont = document.getElementById('contagem')!;
    const nenhum = document.getElementById('nenhum')!;
    const cards = [...document.querySelectorAll<HTMLElement>('#cartoes > li')];
    const norm = (t: string) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    function aplicar() {
      const q = norm(nome.value);
      let n = 0;
      for (const c of cards) {
        const d = c.dataset;
        const ok = (!q || d.nome!.includes(q))
          && (!tp.value || d.tipo === tp.value)
          && (!si.value || (si.value === 'capitulo' ? d.capitulo === '1' : d.situacao === si.value))
          && (!tr.value || d.tradicoes!.split(' ').includes(tr.value));
        c.hidden = !ok;
        if (ok) n++;
      }
      cont.textContent = `${n} ${n === 1 ? 'nome' : 'nomes'}`;
      nenhum.hidden = n > 0;
    }
    form.addEventListener('input', aplicar);
    form.addEventListener('change', aplicar);
    form.addEventListener('reset', () => setTimeout(aplicar));
  </script>
</Base>
