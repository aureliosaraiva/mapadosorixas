---
// Capítulo-panorama (data/capitulos/<id>.json com tipo "panorama"): costura de
// vários capítulos sobre um tema, publicada em /<id>/capitulo/ (ex.: /cosmologia/capitulo/).
import Base from '../../layouts/Base.astro';
import Capitulo from '../../components/Capitulo.astro';
import { panoramas, panoramaPorId, capituloPorId } from '../../lib/capitulos.js';
import { url, rotuloEntidade } from '../../lib/dados.js';

export function getStaticPaths() {
  return panoramas.map((p) => ({ params: { panorama: p.id } }));
}
const { panorama: id } = Astro.params;
const cap = panoramaPorId[id];
const linkados = [...new Set(cap.secoes.flatMap((s) => s.blocos.flatMap((b) => b.tipo === 'paragrafo'
  ? b.tokens.filter((t) => t.t === 'link' && t.tipo === 'capitulo').map((t) => t.alvo) : [])))].filter((c) => capituloPorId[c]);
const paginaTema = id === 'cosmologia' ? { href: url('cosmologia'), rotulo: 'Cosmologia' } : null;
---
<Base titulo={cap.titulo} descricao="Visão de conjunto em texto corrido, que liga vários capítulos do livro, com notas que indicam as fontes." indexar>
  <Capitulo cap={cap} sobretitulo="Livro · Visão de conjunto"
    trilha={[[url('livro'), 'Livro'], ...(paginaTema ? [[paginaTema.href, paginaTema.rotulo] as [string, string]] : [])]}
    textoSelo="Visão de conjunto escrita pelo projeto a partir de livros, pesquisas e dos capítulos do livro, sem acrescentar nada que não esteja nas obras citadas. Ainda não foi revista por sacerdotes, sacerdotisas e pesquisadores."
    tituloVerTambem="Capítulos ligados">
    <section aria-labelledby="ver-tambem" slot="ver-tambem">
      <h2 id="ver-tambem">Capítulos ligados a este texto</h2>
      <ul class="capitulos-do-panorama ver-tambem-lista">
        {linkados.map((c) => <li data-capitulo-linkado={c}><a href={url(`orixas/${c}/capitulo`)}>{capituloPorId[c].titulo}</a> ({rotuloEntidade(c)})</li>)}
      </ul>
      {paginaTema && <p>O que cada obra diz, item por item: <a href={paginaTema.href}>{paginaTema.rotulo}</a>.</p>}
    </section>
  </Capitulo>
</Base>
