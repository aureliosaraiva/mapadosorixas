---
// Dados abertos: fora da navegação principal (só no rodapé), para pesquisadores e
// quem programa. Mesmo aqui, sem pré-fichamento, retidos nem acervo (qa_site.py).
import Base from '../layouts/Base.astro';
import { arquivosDados } from '../lib/downloads.js';
import { url } from '../lib/dados.js';

const kb = (n) => `${(n / 1024).toLocaleString('pt-BR', { maximumFractionDigits: 1 })} KB`;
---
<Base titulo="Dados abertos" descricao="Arquivos com os dados do Mapa dos Orixás, para pesquisadores e quem programa.">
  <header class="cabeca-pagina">
    <p class="sobretitulo">Para pesquisadores</p>
    <h1>Dados abertos</h1>
    <p class="chamada">Os mesmos dados que formam as páginas do site, em arquivos para quem quer estudá-los ou usá-los em outros programas.</p>
  </header>
  <p class="selo" role="note"><span><strong>Direitos de uso: a definir pelo autor.</strong><small>Enquanto não houver licença, consulte antes de reutilizar. Os dados estão em revisão por especialistas e podem ter erros.</small></span></p>
  <div class="texto-corrido">
    <p>Os arquivos estão no formato JSON, que pode ser aberto em qualquer editor de texto ou programa de análise de dados. Cada informação traz a obra de onde veio (que remete ao arquivo das fontes) e a página.</p>
    <p>Ficam de fora, como no site: as informações ainda não conferidas na obra original, as guardadas até a revisão (tabus e alimentos rituais) e as descrições de tradições que ainda não têm fonte.</p>
  </div>

  <div class="tabela-rolagem">
    <table>
      <caption class="visualmente-oculto">{arquivosDados.length} arquivos</caption>
      <thead><tr><th scope="col">Arquivo</th><th scope="col">Conteúdo</th><th scope="col">Tamanho</th></tr></thead>
      <tbody>
        {arquivosDados.map((a) => (
          <tr>
            <td><a href={url(`dados/${a.caminho}`)} download>{a.caminho}</a></td>
            <td>{a.descricao}</td>
            <td>{kb(a.bytes)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="discreto">A descrição técnica dos campos e as somas de verificação dos arquivos estão no <a href={url('dados/LEIAME.txt')}>LEIAME.txt</a>.</p>
</Base>
