---
import Base from '../../layouts/Base.astro';
import Selo from '../../components/Selo.astro';
import Tradicoes from '../../components/Tradicoes.astro';
import TextoGlossario from '../../components/TextoGlossario.astro';
import {
  fichas, fontePorId, divergencias, conexoes, ORDEM_ATRIBUTOS, rotuloAtributo, autorCurto,
  tradicoesDaFicha, totalVersoes, rotuloNo, fichaPorId, ROTULO_ARESTA, ROTULO_SUBTIPO, ROTULO_NO, url,
  marcarGlossario, termoPorId, linhaRevisao, fichaRevisada, versoesRevisadas,
  entidadePorId, ROTULO_TIPO_ENTIDADE, itaDoRegistro,
} from '../../lib/dados.js';
import { capituloPorId } from '../../lib/capitulos.js';
import { elementosCytoscape, vizinhanca, FORMA_NO, CORES_ARESTA, ROTULO_LINHA } from '../../lib/grafo.js';

export function getStaticPaths() {
  return fichas.map((f) => ({ params: { id: f.id } }));
}

const { id } = Astro.params;
const ficha = fichaPorId[id];
const ent = entidadePorId[id];
const atributos = ORDEM_ATRIBUTOS.filter((a) => ficha.atributos[a]);

// Numeração das notas: uma por versão, na ordem em que aparecem.
const notas = [];
const notaDoRegistro = {};
for (const a of atributos) {
  for (const v of ficha.atributos[a]) {
    notas.push(v);
    notaDoRegistro[v.registro] = notas.length;
  }
}

// Glossário: primeira ocorrência de cada termo na página (paráfrases e notas, na
// ordem de exibição) vira link para a página Glossário.
const vistos = new Set();
const marcado = {};
for (const a of atributos) {
  for (const v of ficha.atributos[a]) {
    marcado[v.registro] = { parafrase: marcarGlossario(v.parafrase, vistos), nota: marcarGlossario(v.nota, vistos) };
  }
}
const termosUsados = [...vistos].map((t) => termoPorId[t]).sort((a, b) => a.termo.localeCompare(b.termo, 'pt-BR'));

const divs = divergencias.filter((d) => d.orixa === id);
const viz = vizinhanca(id);
const arestas = viz.arestas;
const elementosMini = elementosCytoscape(viz.nos, viz.arestas);
const tiposNoMini = [...new Set(viz.nos.map((n) => n.tipo))];
const tiposArestaMini = [...new Set(viz.arestas.map((e) => e.tipo))];
const pend = ficha.pendencias;
const preFich = Object.entries(pend.so_pre_fichamento);
const retidos = Object.entries(pend.retidos_ate_conselho);
const revisada = fichaRevisada(ficha);
const nRevisadas = versoesRevisadas(ficha);
---
<Base titulo={ficha.rotulo} descricao={`Ficha de ${ficha.rotulo}: versões por tradição, com fonte, página e divergências.`} indexar>
  <p><a href={url('catalogo')}>← Catálogo</a></p>
  <h1>{ficha.rotulo}</h1>
  {revisada
    ? <p class="selo-revisado" role="note">Todas as versões desta ficha foram revisadas por praticantes ou pesquisadores, cada uma em nome da sua tradição. Quem revisou e quando aparece abaixo de cada versão.</p>
    : <Selo />}

  {capituloPorId[id] && <p class="nota-caixa link-capitulo"><strong>Capítulo:</strong> <a href={url(`orixas/${id}/capitulo`)}>{capituloPorId[id].titulo}</a> — texto corrido sobre {ficha.rotulo}, escrito a partir destas versões, com notas de rodapé.</p>}
  {ent.tipo !== 'orixa' && <p class="tipo-entidade">Tipo (classificação de trabalho): {ROTULO_TIPO_ENTIDADE[ent.tipo]}</p>}
  {ent.sensivel && <p class="aviso-sensivel nota-caixa">Tema sensível: esta ficha traz só o que é público em fonte acadêmica, sem fundamento iniciático.</p>}
  <p>{totalVersoes(ficha)} versões, cada uma com nota para a fonte (autor, ano e página). Quando há mais de uma versão para o mesmo atributo, todas são mostradas, com a tradição e a casa ou região indicadas pela fonte, <strong>sem hierarquia entre elas</strong>.</p>
  <p><strong>Tradições citadas:</strong> <Tradicoes ids={tradicoesDaFicha(ficha)} link /> (<a href={url('tradicoes')}>o que é cada tradição</a>)</p>

  <nav aria-label="Seções da ficha">
    <ul class="sumario">
      {atributos.map((a) => <li><a href={`#${a}`}>{rotuloAtributo(a)} ({ficha.atributos[a].length})</a></li>)}
      <li><a href="#divergencias">Divergências</a></li>
      <li><a href="#conexoes">Conexões</a></li>
      {termosUsados.length > 0 && <li><a href="#termos">Termos do glossário</a></li>}
      <li><a href="#pendencias">Pendências</a></li>
      <li><a href="#notas">Notas e fontes</a></li>
    </ul>
  </nav>

  {atributos.map((a) => (
    <section class="atributo" aria-labelledby={a}>
      <h2 id={a}>{rotuloAtributo(a)}</h2>
      {ficha.atributos[a].length > 1 && <p class="meta">{ficha.atributos[a].length} versões registradas.</p>}
      <ul class="versoes">
        {ficha.atributos[a].map((v) => {
          const n = notaDoRegistro[v.registro];
          return (
            <li class="versao" id={`v-${v.registro}`}>
              <span class="valor">{v.valor}</span>
              <sup class="ref"><a href={`#nota-${n}`} id={`ref-${n}`} aria-label={`Nota ${n}: fonte`}>[{n}]</a></sup>
              <div class="meta">
                <Tradicoes ids={v.tradicoes} />
                {v.casa_ou_regiao && <span> · Casa ou região: {v.casa_ou_regiao}</span>}
              </div>
              <p><TextoGlossario partes={marcado[v.registro].parafrase} /></p>
              {v.nota && <p class="nota"><strong>Nota do fichamento:</strong> <TextoGlossario partes={marcado[v.registro].nota} /></p>}
              {itaDoRegistro[v.registro] && <p class="meta ligacao-ita">Itã: <a href={url(`itans/${itaDoRegistro[v.registro].id}#vi-${v.registro}`)}>{itaDoRegistro[v.registro].titulo}</a> ({itaDoRegistro[v.registro].versoes.length} {itaDoRegistro[v.registro].versoes.length === 1 ? 'versão' : 'versões'} lado a lado)</p>}
              {v.revisoes && (
                <ul class="revisoes" aria-label="Revisões desta versão">
                  {v.revisoes.map((rv) => <li class="revisao" data-parecer={rv.parecer}>{linhaRevisao(rv)}</li>)}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <section aria-labelledby="divergencias">
    <h2 id="divergencias">Divergências</h2>
    {divs.length === 0 ? <p>Nenhum atributo com mais de uma versão registrada.</p> : (
      <>
        <p>Atributos em que as fontes registram mais de uma versão. As linhas estão na ordem do fichamento, não por importância.</p>
        {divs.map((d) => (
          <div class="tabela-rolagem">
            <table>
              <caption>{rotuloAtributo(d.atributo)}: {d.versoes.length} versões</caption>
              <thead><tr><th scope="col">Versão</th><th scope="col">Tradição</th><th scope="col">Casa ou região</th><th scope="col">Fonte</th></tr></thead>
              <tbody>
                {d.versoes.map((v) => {
                  const n = notaDoRegistro[v.registro];
                  return (
                    <tr>
                      <td>{v.valor}</td>
                      <td><Tradicoes ids={v.tradicoes} /></td>
                      <td>{v.casa_ou_regiao ?? '—'}</td>
                      <td>
                        {autorCurto(fontePorId[v.fonte])} ({fontePorId[v.fonte]?.ano ?? 's.d.'}){v.via && <> via {autorCurto(fontePorId[v.via])} ({fontePorId[v.via]?.ano})</>}, {v.localizacao}
                        {n && <sup class="ref"><a href={`#nota-${n}`} aria-label={`Nota ${n}`}>[{n}]</a></sup>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))}
      </>
    )}
  </section>

  <section aria-labelledby="conexoes">
    <h2 id="conexoes">Conexões</h2>
    {arestas.length === 0 ? <p>Nenhuma conexão registrada.</p> : (
      <>
        <p>Conexões com fonte em que {ficha.rotulo} aparece ({arestas.length} conexões com {viz.nos.length - 1} nós vizinhos). Veja todas no <a href={url('grafo')}>grafo completo</a>.</p>
        <div class="grafo-caixa mini so-js">
          <div id="mini-grafo" role="img" aria-label={`Mini-grafo dos vizinhos diretos de ${ficha.rotulo}. A lista abaixo descreve as mesmas conexões, com as fontes.`}></div>
        </div>
        <p class="meta so-js">Legenda — nós: {tiposNoMini.map((t) => `${ROTULO_NO[t] ?? t} (${FORMA_NO[t]?.rotulo})`).join('; ')}. Conexões: {tiposArestaMini.map((t) => `${ROTULO_ARESTA[t] ?? t} (linha ${ROTULO_LINHA[CORES_ARESTA[t]?.estilo]})`).join('; ')}. Nós com borda dourada têm ficha: clique para abrir.</p>
        <h3 id="lista-conexoes">Lista de conexões</h3>
        <ul>
          {arestas.map((e) => {
            const no = (x) => (fichaPorId[x] && x !== id ? <a href={url(`orixas/${x}`)}>{rotuloNo(x)}</a> : rotuloNo(x));
            const rel = e.subtipo ? ROTULO_SUBTIPO[e.subtipo] ?? e.subtipo : (e.direcionada ? '→' : '—');
            return (
              <li>
                <strong>{ROTULO_ARESTA[e.tipo] ?? e.tipo}:</strong> {no(e.origem)} {rel} {no(e.destino)}{' '}
                ({e.versoes.map((v, i) => (
                  <>{i > 0 && '; '}{notaDoRegistro[v.registro]
                    ? <a href={`#nota-${notaDoRegistro[v.registro]}`}>nota {notaDoRegistro[v.registro]}</a>
                    : <>{autorCurto(fontePorId[v.source_id])} ({fontePorId[v.source_id]?.ano}), {v.localizacao}</>}</>
                ))})
              </li>
            );
          })}
        </ul>
      </>
    )}
  </section>

  {termosUsados.length > 0 && (
    <section aria-labelledby="termos">
      <h2 id="termos">Termos do glossário nesta página</h2>
      <p>Termos marcados com sublinhado pontilhado no texto acima. A definição completa, com fonte e página, está no <a href={url('glossario')}>glossário</a>.</p>
      <dl class="termos-pagina">
        {termosUsados.map((t) => (
          <>
            <dt><a href={url(`glossario#termo-${t.id}`)}>{t.termo}</a></dt>
            <dd id={`def-${t.id}`}>{t.definicao}</dd>
          </>
        ))}
      </dl>
    </section>
  )}

  <section aria-labelledby="pendencias">
    <h2 id="pendencias">Pendências e campos sem fonte</h2>
    <p>O que ainda falta nesta ficha. Nenhum desses campos foi preenchido sem fonte.</p>
    <dl>
      <dt><strong>Sem nenhum registro no fichamento</strong></dt>
      <dd>{pend.sem_registro.length ? pend.sem_registro.map(rotuloAtributo).join(', ') : '—'}</dd>
      <dt><strong>Só em pré-fichamento</strong> (afirmação localizada, mas a fonte ainda não foi lida no original; fica fora da ficha)</dt>
      <dd>{preFich.length ? preFich.map(([a, ids]) => `${rotuloAtributo(a)} (${ids.join(', ')})`).join('; ') : '—'}</dd>
      <dt><strong>Retidos até decisão do conselho</strong> (fichados, mas não exibidos: tabus e alimentos rituais, ou registros que um revisor pediu para não publicar)</dt>
      <dd>{retidos.length ? retidos.map(([a, ids]) => `${rotuloAtributo(a)}: ${ids.length} registro(s)`).join('; ') : '—'}</dd>
      <dt><strong>Revisão por praticantes e pesquisadores</strong></dt>
      <dd id="estado-revisao">{nRevisadas ? `${nRevisadas} de ${totalVersoes(ficha)} versões com revisão vigente, por ${ficha.revisao.length} combinação(ões) de revisor e tradição.` : 'Ainda não revisada.'}</dd>
    </dl>
  </section>

  <section aria-labelledby="notas">
    <h2 id="notas">Notas e fontes</h2>
    <ol class="notas">
      {notas.map((v, i) => {
        const n = i + 1;
        return (
          <li id={`nota-${n}`}>
            {v.sources.map((s) => {
              const f = fontePorId[s.id];
              const via = s.via ? fontePorId[s.via] : null;
              return (
                <span>
                  <a href={url(`fontes#fonte-${s.id}`)}>{autorCurto(f)} ({f?.ano ?? 's.d.'})</a>, <cite>{f?.titulo}</cite>
                  {via && <>, citado por <a href={url(`fontes#fonte-${s.via}`)}>{autorCurto(via)} ({via.ano})</a></>}
                  , {s.loc}.{' '}
                </span>
              );
            })}
            <span class="meta">Registro <code>{v.registro}</code>.</span>{' '}
            <a href={`#ref-${n}`} aria-label={`Voltar ao texto da nota ${n}`}>↩</a>
          </li>
        );
      })}
    </ol>
  </section>
  {arestas.length > 0 && (
    <script type="application/json" id="dados-mini-grafo" data-centro={id} set:html={JSON.stringify(elementosMini)}></script>
  )}
  <script>
    import '../../lib/dica-glossario';
  </script>
  <script>
    import cytoscape from 'cytoscape';
    import { estiloCytoscape } from '../../lib/estilo-cytoscape';

    const dados = document.getElementById('dados-mini-grafo');
    const caixa = document.getElementById('mini-grafo');
    if (dados && caixa) {
      const centro = dados.dataset.centro!;
      const cy = cytoscape({
        container: caixa,
        elements: JSON.parse(dados.textContent!),
        minZoom: 0.4,
        maxZoom: 2.5,
        userZoomingEnabled: false,
        style: [...estiloCytoscape, { selector: `node[id = "${centro}"]`, style: { 'border-width': 4, 'border-color': '#0b5cad', width: 52, height: 52 } }],
        layout: { name: 'concentric', concentric: (n: any) => (n.id() === centro ? 2 : 1), levelWidth: () => 1, minNodeSpacing: 40, padding: 24, animate: false } as any,
      });
      cy.on('tap', 'node', (ev) => {
        const href = ev.target.data('href');
        if (href && ev.target.id() !== centro) window.location.href = href;
      });
      cy.on('mouseover', 'node[href != ""]', (ev) => { if (ev.target.id() !== centro) (cy.container() as HTMLElement).style.cursor = 'pointer'; });
      cy.on('mouseout', 'node', () => { (cy.container() as HTMLElement).style.cursor = ''; });
    }
  </script>
</Base>
