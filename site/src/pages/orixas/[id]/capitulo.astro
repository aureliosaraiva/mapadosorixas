---
// Capítulo narrativo de um orixá: texto do projeto (data/capitulos/<id>.json),
// com notas de rodapé que remetem a registros do fichamento.
import Base from '../../../layouts/Base.astro';
import Selo from '../../../components/Selo.astro';
import CorpoCapitulo from '../../../components/CorpoCapitulo.astro';
import { capitulos, capituloPorId, TITULO_SECAO, registrosCitados, panoramas } from '../../../lib/capitulos.js';
import { fichaPorId, url, itaDoRegistro, entidadePorId } from '../../../lib/dados.js';

export function getStaticPaths() {
  return capitulos.map((c) => ({ params: { id: c.orixa } }));
}
const { id } = Astro.params;
const cap = capituloPorId[id];
const ficha = fichaPorId[id];
const ent = entidadePorId[id];
const comTitulo = cap.secoes.filter((s) => s.slug !== 'abertura');
const itansCitados = [...new Set([...registrosCitados(cap)].map((r) => itaDoRegistro[r]).filter(Boolean))];
const nRegistros = registrosCitados(cap).size;
// panoramas que linkam para este capítulo
const emPanoramas = panoramas.filter((p) => p.secoes.some((s) => s.blocos.some((b) => b.tipo === 'paragrafo'
  && b.tokens.some((t) => t.t === 'link' && t.tipo === 'capitulo' && t.alvo === id))));
---
<Base titulo={`${ficha.rotulo} — capítulo`} descricao={`Capítulo narrativo sobre ${ficha.rotulo}, escrito a partir do fichamento de fontes, com notas de rodapé.`} indexar>
  <p class="trilha"><a href={url('livro')}>← Livro</a> · <a href={url(`orixas/${id}`)}>Ficha de {ficha.rotulo}</a></p>
  <p class="sobretitulo">Capítulo · {ficha.rotulo}</p>
  <h1>{cap.titulo}</h1>
  {ent?.sensivel && <p class="aviso-sensivel nota-caixa">Tema sensível: este capítulo traz só o que é público em fonte acadêmica, sem fundamento iniciático.</p>}
  <Selo texto="Este capítulo foi escrito pelo projeto a partir do fichamento de fontes escritas, sem conteúdo novo. Ainda não passou pelo conselho de revisão; erros e lacunas são esperados." />
  <p class="nota-caixa como-ler">Texto corrido, montado só com os {nRegistros} registros do fichamento citados nas notas. Os números sobrescritos levam à nota com autor, ano e página; quando as tradições divergem, as versões aparecem lado a lado, sem eleger uma correta. Para a lista de versões com a fonte de cada uma, veja a <a href={url(`orixas/${id}`)}>ficha</a>. Atualizado em {cap.atualizado.split('-').reverse().join('/')}.</p>

  <nav aria-label="Seções do capítulo">
    <ol class="sumario sumario-capitulo">
      {comTitulo.map((s) => <li><a href={`#${s.slug}`}>{s.titulo ?? TITULO_SECAO[s.slug]}</a></li>)}
      <li><a href="#notas">Notas</a></li>
      <li><a href="#bibliografia">Fontes citadas</a></li>
    </ol>
  </nav>

  <CorpoCapitulo cap={cap} hrefPendenciasFicha={url(`orixas/${id}#pendencias`)}>
    <section aria-labelledby="ver-tambem" slot="ver-tambem">
      <h2 id="ver-tambem">Ver também</h2>
      <ul>
        <li><a href={url(`orixas/${id}`)}>Ficha de {ficha.rotulo}</a>: todas as versões, divergências e pendências.</li>
        <li><a href={url(`orixas/${id}#conexoes`)}>Conexões de {ficha.rotulo} no grafo</a> e o <a href={url('grafo')}>grafo completo</a>.</li>
        {itansCitados.length > 0 && <li>Itãs citados: {itansCitados.map((it, i) => <>{i > 0 && ', '}<a href={url(`itans/${it.id}`)}>{it.titulo}</a></>)}.</li>}
        {emPanoramas.map((p) => <li>Panorama: <a href={url(`${p.id}/capitulo`)}>{p.titulo}</a>.</li>)}
        <li><a href={url('glossario')}>Glossário</a> e <a href={url('tradicoes')}>tradições</a>.</li>
      </ul>
    </section>
  </CorpoCapitulo>
</Base>
