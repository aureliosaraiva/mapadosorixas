---
// Capítulo narrativo de um orixá: texto do projeto (data/capitulos/<id>.json),
// com notas de rodapé que remetem às obras de onde veio cada informação.
import Base from '../../../layouts/Base.astro';
import Capitulo from '../../../components/Capitulo.astro';
import { capitulos, capituloPorId, registrosCitados, panoramas } from '../../../lib/capitulos.js';
import { fichaPorId, url, itaDoRegistro, entidadePorId } from '../../../lib/dados.js';

export function getStaticPaths() {
  return capitulos.map((c) => ({ params: { id: c.orixa } }));
}
const { id } = Astro.params;
const cap = capituloPorId[id];
const ficha = fichaPorId[id];
const ent = entidadePorId[id];
const itansCitados = [...new Set([...registrosCitados(cap)].map((r) => itaDoRegistro[r]).filter(Boolean))];
// panoramas que linkam para este capítulo
const emPanoramas = panoramas.filter((p) => p.secoes.some((s) => s.blocos.some((b) => b.tipo === 'paragrafo'
  && b.tokens.some((t) => t.t === 'link' && t.tipo === 'capitulo' && t.alvo === id))));
---
<Base titulo={cap.titulo} descricao={`${cap.titulo}: capítulo sobre ${ficha.rotulo}, com notas que indicam as obras de onde veio cada informação.`} indexar>
  <Capitulo cap={cap} sobretitulo={`Livro · ${ficha.rotulo}`}
    trilha={[[url('livro'), 'Livro'], [url(`orixas/${id}`), `Página de ${ficha.rotulo}`]]}
    textoSelo="Texto escrito pelo projeto a partir de livros e pesquisas, sem acrescentar nada que não esteja nas obras citadas. Ainda não foi revisto por sacerdotes, sacerdotisas e pesquisadores."
    sensivel={!!ent?.sensivel} hrefPendenciasFicha={url(`orixas/${id}#pendencias`)} tituloVerTambem="Continue lendo">
    <section aria-labelledby="ver-tambem" slot="ver-tambem">
      <h2 id="ver-tambem">Continue lendo</h2>
      <ul class="ver-tambem-lista">
        <li><a href={url(`orixas/${id}`)}>Página de {ficha.rotulo}</a>: resumo, o que cada tradição registra e as variações entre casas e nações.</li>
        <li><a href={url(`orixas/${id}#conexoes`)}>Com quem {ficha.rotulo} se relaciona</a> e o <a href={url('grafo')}>mapa de conexões completo</a>.</li>
        {itansCitados.length > 0 && <li>Mitos contados aqui: {itansCitados.map((it, i) => <>{i > 0 && ', '}<a href={url(`itans/${it.id}`)}>{it.titulo}</a></>)}.</li>}
        {emPanoramas.map((p) => <li>Visão de conjunto: <a href={url(`${p.id}/capitulo`)}>{p.titulo}</a>.</li>)}
        <li><a href={url('glossario')}>Glossário</a> e <a href={url('tradicoes')}>tradições e nações</a>.</li>
      </ul>
    </section>
  </Capitulo>
</Base>
