---
import Base from '../layouts/Base.astro';
import Citacoes from '../components/Citacoes.astro';
import {
  tradicoes, tradicoesMeta, ROTULO_GRUPO, ORDEM_GRUPOS, fichas, tradicoesDaFicha, url,
} from '../lib/dados.js';

// Tradição com descrição exibida precisa de fonte; sem fonte, o texto do rascunho
// NÃO é exibido (só o nome e o aviso de pendência).
for (const t of tradicoes) {
  if (t.status === 'com_fonte' && !t.sources?.length) throw new Error(`Tradição com_fonte sem fontes: ${t.id}`);
}
const INTRO_GRUPO = {
  candomble: 'Nações do Candomblé registradas nas fontes. O site trata Candomblé e Umbanda como religiões distintas.',
  afro_brasileira_regional: 'Outras religiões afro-brasileiras citadas nas fontes, que o site não inclui nem no grupo do Candomblé nem no da Umbanda.',
  umbanda: 'Umbanda, em grupo próprio. No site, as etiquetas de Umbanda têm borda tracejada.',
  culto_africano: 'Cultos em território africano citados nas fontes.',
  diaspora_caribenha: 'Religiões da diáspora no Caribe citadas nas fontes.',
};
const grupos = ORDEM_GRUPOS.map((g) => [g, tradicoes.filter((t) => t.grupo === g)]).filter(([, ts]) => ts.length);
const outros = tradicoes.filter((t) => !ORDEM_GRUPOS.includes(t.grupo));
if (outros.length) throw new Error(`Grupo de tradição sem lugar na página: ${outros.map((t) => t.id).join(', ')}`);
const fichasDa = (id) => fichas.filter((f) => tradicoesDaFicha(f).includes(id));
const nComFonte = tradicoes.filter((t) => t.status === 'com_fonte').length;
---
<Base titulo="Tradições" descricao="As tradições citadas nas fichas: nações do Candomblé, Umbanda, religiões afro-brasileiras regionais, culto na África e diáspora caribenha." indexar>
  <h1>Tradições</h1>
  <p>Cada versão das fichas leva a tradição que a fonte indica. Esta página reúne as {tradicoes.length} tradições usadas no projeto, agrupadas. {nComFonte} têm descrição com fonte e página; as outras {tradicoes.length - nComFonte} aparecem só pelo nome, com a descrição <strong>pendente de fonte</strong>.</p>
  <p class="nota-caixa">{tradicoesMeta.aviso}</p>

  <nav aria-label="Grupos de tradições">
    <ul class="sumario">
      {grupos.map(([g, ts]) => <li><a href={`#grupo-${g}`}>{ROTULO_GRUPO[g]} ({ts.length})</a></li>)}
    </ul>
  </nav>

  {grupos.map(([g, ts]) => (
    <section aria-labelledby={`grupo-${g}`}>
      <h2 id={`grupo-${g}`}>{ROTULO_GRUPO[g]}</h2>
      <p>{INTRO_GRUPO[g]}{(g === 'candomble' || g === 'umbanda') && <> Ver <a href={url('metodologia#candomble-umbanda')}>Metodologia, Candomblé × Umbanda</a>.</>}</p>
      <ul class="tradicoes-lista">
        {ts.map((t) => {
          const fs = fichasDa(t.id);
          return (
            <li class={`tradicao g-${g}`} id={`t-${t.id}`} data-status={t.status}>
              <h3><span class={`etiqueta g-${g}`}>{t.nome}</span></h3>
              {t.status === 'com_fonte' ? (
                <>
                  <p class="descricao">{t.descricao}</p>
                  <p class="fontes-tradicao"><strong>Fonte{t.sources.length > 1 ? 's' : ''}:</strong> <Citacoes sources={t.sources} /></p>
                  {t.nota && <p class="nota"><strong>Nota:</strong> {t.nota}</p>}
                </>
              ) : (
                <p class="pendente-fonte" role="note"><strong>Descrição pendente de fonte.</strong> Ainda não há fonte aberta lida para descrever esta tradição; o projeto não publica texto sem fonte (ver pendências no repositório).</p>
              )}
              <p class="meta">{fs.length
                ? <>Citada nas fichas de {fs.map((f, i) => <>{i > 0 && ', '}<a href={url(`orixas/${f.id}`)}>{f.rotulo}</a></>)}.</>
                : 'Ainda não citada em nenhuma ficha.'}</p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
