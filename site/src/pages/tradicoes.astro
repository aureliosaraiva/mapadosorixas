---
import Base from '../layouts/Base.astro';
import Citacoes from '../components/Citacoes.astro';
import {
  tradicoes, ROTULO_GRUPO, ORDEM_GRUPOS, fichas, tradicoesDaFicha, url,
} from '../lib/dados.js';

// Tradição com descrição exibida precisa de fonte; sem fonte, o texto do rascunho
// NÃO é exibido (só o nome e o aviso de pendência).
for (const t of tradicoes) {
  if (t.status === 'com_fonte' && !t.sources?.length) throw new Error(`Tradição com_fonte sem fontes: ${t.id}`);
}
const INTRO_GRUPO = {
  candomble: 'As nações do Candomblé que aparecem nas obras. Candomblé e Umbanda são tratados aqui como religiões distintas.',
  afro_brasileira_regional: 'Outras religiões afro-brasileiras citadas nas obras, que não se confundem nem com o Candomblé nem com a Umbanda.',
  umbanda: 'A Umbanda, em grupo próprio. No site, as etiquetas de Umbanda têm borda tracejada.',
  culto_africano: 'O culto aos orixás em terra africana, como aparece nas obras.',
  diaspora_caribenha: 'Religiões de matriz africana no Caribe, como a Santería cubana.',
};
const grupos = ORDEM_GRUPOS.map((g) => [g, tradicoes.filter((t) => t.grupo === g)]).filter(([, ts]) => ts.length);
const outros = tradicoes.filter((t) => !ORDEM_GRUPOS.includes(t.grupo));
if (outros.length) throw new Error(`Grupo de tradição sem lugar na página: ${outros.map((t) => t.id).join(', ')}`);
const fichasDa = (id) => fichas.filter((f) => tradicoesDaFicha(f).includes(id));
const nComFonte = tradicoes.filter((t) => t.status === 'com_fonte').length;
---
<Base titulo="Tradições e nações" descricao="As tradições citadas no site: nações do Candomblé, Umbanda, outras religiões afro-brasileiras, culto na África e no Caribe." indexar>
  <header class="cabeca-pagina">
    <p class="sobretitulo">Tradições e nações</p>
    <h1>Em cada tradição, um jeito de cultuar</h1>
    <p class="chamada">Cada informação do site indica a tradição de onde vem, como a obra registra. Estas são as {tradicoes.length} tradições citadas, em grupos.</p>
  </header>
  <p class="discreto texto-corrido">{nComFonte} já têm uma descrição com fonte; as outras aparecem só pelo nome até haver obra lida sobre elas.</p>

  <nav aria-label="Grupos de tradições">
    <ul class="sumario-pagina">
      {grupos.map(([g, ts]) => <li><a href={`#grupo-${g}`}>{ROTULO_GRUPO[g]} ({ts.length})</a></li>)}
    </ul>
  </nav>

  {grupos.map(([g, ts]) => (
    <section aria-labelledby={`grupo-${g}`}>
      <h2 id={`grupo-${g}`}>{ROTULO_GRUPO[g]}</h2>
      <p class="intro-secao">{INTRO_GRUPO[g]}{(g === 'candomble' || g === 'umbanda') && <> Veja também <a href={url('sobre#candomble-umbanda')}>Candomblé e Umbanda</a>.</>}</p>
      <ul class="tradicoes-lista">
        {ts.map((t) => {
          const fs = fichasDa(t.id);
          return (
            <li class={`tradicao g-${g}`} id={`t-${t.id}`} data-status={t.status}>
              <h3><span class={`etiqueta g-${g}`}>{t.nome}</span></h3>
              {t.status === 'com_fonte' ? (
                <>
                  <p class="descricao">{t.descricao}</p>
                  <p class="fontes-tradicao"><strong>De acordo com</strong> <Citacoes sources={t.sources} /></p>
                  {t.nota && <p class="nota"><strong>Observação:</strong> {t.nota}</p>}
                </>
              ) : (
                <p class="pendente-fonte" role="note"><strong>Descrição em preparo.</strong> Ainda não há obra lida para descrever esta tradição, e o site não publica texto sem fonte.</p>
              )}
              <p class="meta">{fs.length
                ? <>Aparece em: {fs.map((f, i) => <>{i > 0 && ', '}<a href={url(`orixas/${f.id}`)}>{f.rotulo}</a></>)}.</>
                : 'Ainda não aparece em nenhuma página.'}</p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
