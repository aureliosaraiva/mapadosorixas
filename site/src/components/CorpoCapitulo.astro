---
// Corpo comum dos capítulos (de orixá e panorama): texto com chamadas de nota,
// notas de rodapé, fontes citadas e termos do glossário. O slot "ver-tambem"
// entra entre o texto e as notas. O qa_site.py §12 confere este HTML contra o JSON.
import TextoGlossario from './TextoGlossario.astro';
import { TITULO_SECAO, registro, bibliografia, italicos, hrefLink, textoLacuna, CAUTELA } from '../lib/capitulos.js';
import { fontePorId, autorCurto, fichaPorId, url, marcarGlossario, termoPorId } from '../lib/dados.js';

interface Props { cap: any; hrefPendenciasFicha?: string }
const { cap, hrefPendenciasFicha } = Astro.props;
const secoes = cap.secoes;

// glossário: primeira ocorrência de cada termo no texto (fora dos links)
const vistos = new Set();
const render = secoes.map((s) => ({
  ...s,
  blocos: s.blocos.map((b) => b.tipo !== 'paragrafo' ? b : {
    ...b,
    tokens: b.tokens.map((t) => t.t !== 'texto' ? t : {
      ...t,
      pedacos: italicos(t.v).map((p) => ({ ...p, partes: p.italico ? [{ texto: p.texto }] : marcarGlossario(p.texto, vistos) })),
    }),
  }),
}));
const termosUsados = [...vistos].map((t) => termoPorId[t]).sort((a, b) => a.termo.localeCompare(b.termo, 'pt-BR'));
const biblio = bibliografia(cap);
// a informação aparece na página da sua entidade (retidas e não publicadas ficam sem link)
const naFicha = (r) => {
  const f = fichaPorId[r.orixa];
  return !!f && Object.values(f.atributos).some((vs) => vs.some((v) => v.registro === r.id));
};
---
<article class="capitulo">
  {render.map((s) => (
    <section aria-labelledby={s.slug !== 'abertura' ? s.slug : undefined} class={`secao-capitulo secao-${s.slug}`} data-secao={s.slug}>
      {s.slug !== 'abertura' && <h2 id={s.slug}>{s.titulo ?? TITULO_SECAO[s.slug]}</h2>}
      {s.blocos.map((b) => b.tipo === 'subtitulo'
        ? <h3>{b.texto}</h3>
        : (
          <p class="paragrafo-capitulo">
            {b.tokens.map((t) => t.t === 'texto'
              ? t.pedacos.map((p) => p.italico ? <em>{p.texto}</em> : <TextoGlossario partes={p.partes} />)
              : t.t === 'link'
                ? <a href={hrefLink(t)} class={`link-${t.tipo}`}>{t.rotulo}</a>
                : <sup class="ref"><a href={`#nota-${t.n}`} id={`ref-${t.n}`} aria-label={`Nota ${t.n}`}>{t.n}</a></sup>)}
          </p>
        ))}
    </section>
  ))}
</article>

<div class="apos-capitulo">
<slot name="ver-tambem" />

<section aria-labelledby="notas">
  <h2 id="notas">Notas</h2>
  <ol class="notas notas-capitulo">
    {cap.notas.map((n) => (
      <li id={`nota-${n.n}`} data-nota={n.n}>
        {n.itens.map((it) => {
          if (it.tipo === 'registro') {
            const r = registro(it.registro);
            const f = fontePorId[r.source_id];
            const via = r.via_source_id ? fontePorId[r.via_source_id] : null;
            return (
              <span class="item-nota" data-registro={r.id}>
                <a href={url(`fontes#fonte-${r.source_id}`)}>{autorCurto(f)} ({f?.ano ?? 's.d.'})</a>
                {via && <>, citado por <a href={url(`fontes#fonte-${r.via_source_id}`)}>{autorCurto(via)} ({via.ano ?? 's.d.'})</a></>}
                , {r.localizacao}
                {naFicha(r) && <> (<a href={url(`orixas/${r.orixa}#v-${r.id}`)}>ver em {fichaPorId[r.orixa].rotulo}</a>)</>}.{' '}
              </span>
            );
          }
          if (it.tipo === 'lacuna') return <span class="item-nota lacuna" data-lacuna={`${it.atributo}${it.tradicao ? '@' + it.tradicao : ''}`}>{textoLacuna(it, cap)} {hrefPendenciasFicha && <a href={hrefPendenciasFicha}>O que ainda falta</a>}.{' '}</span>;
          return <span class="item-nota pendencia" data-pendencia={it.ancora}>Assunto ainda em estudo, à espera de uma obra ou de uma decisão da revisão: {italicos(it.ancora).map((p) => p.italico ? <em>{p.texto}</em> : p.texto)}.{' '}</span>;
        })}
        <a class="voltar-nota" href={`#ref-${n.n}`} aria-label={`Voltar ao texto da nota ${n.n}`}>↩</a>
      </li>
    ))}
  </ol>
</section>

<section aria-labelledby="bibliografia">
  <h2 id="bibliografia">Obras citadas</h2>
  <ul class="bibliografia">
    {biblio.map((f) => (
      <li data-fonte={f.id}><a href={url(`fontes#fonte-${f.id}`)}>{(f.autores || []).join('; ')} ({f.ano ?? 's.d.'})</a>. <cite>{f.titulo}</cite>.{f.confiabilidade_preliminar === 'C' && ` ${CAUTELA}`}</li>
    ))}
  </ul>
</section>

{termosUsados.length > 0 && (
  <section aria-labelledby="termos">
    <h2 id="termos">Palavras deste capítulo</h2>
    <dl class="termos-pagina">
      {termosUsados.map((t) => (
        <>
          <dt><a href={url(`glossario#termo-${t.id}`)}>{t.termo}</a></dt>
          <dd id={`def-${t.id}`}>{t.definicao}</dd>
        </>
      ))}
    </dl>
  </section>
)}
</div>
