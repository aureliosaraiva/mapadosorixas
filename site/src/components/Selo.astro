---
interface Props { texto?: string }
const { texto = 'Esta ficha foi montada automaticamente a partir do fichamento de fontes escritas. Ainda não passou pelo conselho de revisão; erros e lacunas são esperados.' } = Astro.props;
---
<p class="selo" role="note">
  Rascunho — aguardando revisão de praticantes e pesquisadores
  <small>{texto}</small>
</p>
