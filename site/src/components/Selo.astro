---
import Icone from './Icone.astro';
import { AVISO_REVISAO } from '../lib/textos.js';
interface Props { texto?: string }
const { texto = 'Esta página reúne o que livros e pesquisas registram. Ainda não foi revista por sacerdotes, sacerdotisas e pesquisadores; pode haver erros e lacunas.' } = Astro.props;
---
<p class="selo" role="note">
  <Icone nome="revisao" />
  <span><strong>{AVISO_REVISAO}</strong><small>{texto}</small></span>
</p>
