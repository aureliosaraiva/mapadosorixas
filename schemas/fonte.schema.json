{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aureliosaraiva/mapadosorixas/schemas/fonte.schema.json",
  "title": "Fonte bibliográfica",
  "type": "object",
  "required": ["id", "tipo", "categoria", "autores", "titulo", "ano", "idioma", "tradicoes", "confiabilidade_preliminar", "status_verificacao"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tipo": { "enum": ["livro", "capitulo", "artigo", "tese", "dissertacao", "site", "audiovisual", "acervo", "documento"] },
    "categoria": { "enum": ["etno_classica", "academica", "tese", "corpus_oral", "praticante", "enciclopedia", "acervo", "patrimonio", "web_divulgacao", "divulgacao", "audiovisual", "iconografia"] },
    "autores": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "titulo": { "type": "string", "minLength": 1 },
    "ano": { "type": ["integer", "null"], "minimum": 1500, "maximum": 2100 },
    "idioma": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "tradicoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tradicao" } },
    "confiabilidade_preliminar": { "enum": ["A", "B", "C", "D"] },
    "status_verificacao": { "enum": ["pista", "a_verificar", "conferido_web", "verificado", "fichado", "revisado"] },
    "observacoes": { "type": ["string", "null"] },
    "editora": { "type": "string" },
    "local": { "type": "string" },
    "periodico": { "type": "string" },
    "url": { "type": ["string", "null"], "format": "uri" },
    "identificadores": { "type": "object", "additionalProperties": { "type": "string" } },
    "evidencias": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "tradicao": {
      "enum": [
        "ioruba_nigeria", "vodun_benim", "kongo",
        "candomble_ketu", "candomble_jeje", "candomble_angola", "candomble_ijexa", "candomble_efon",
        "xango_pernambuco", "xango_sergipe", "tambor_de_mina", "batuque_rs", "umbanda",
        "lucumi", "palo_monte", "arara", "vodou_haiti", "orisha_trinidad", "benim"
      ]
    }
  }
}
